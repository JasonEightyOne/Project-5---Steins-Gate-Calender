# Copy to .env.local and fill in. Never commit .env.local.

# Time zone used for all dates and reminder times
APP_TIMEZONE=Asia/Kuala_Lumpur
# When all-day reminders fire (HH:MM)
ALL_DAY_REMINDER_TIME=09:00
# --- Database
# Hosted (required on Vercel): a Turso database, see README "Deploy on Vercel"
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local only: when TURSO_DATABASE_URL is empty, data goes in this SQLite file
DATABASE_PATH=./data/calendar.db

# --- Scheduler: the secret an external cron service sends to /api/cron
# Generate one with: openssl rand -hex 24
CRON_SECRET=

# --- Email (Gmail): create an App Password at https://myaccount.google.com/apppasswords (requires 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_TO=you@gmail.com

# --- Phone push via ntfy (free): install the ntfy app, subscribe to a hard-to-guess topic
NTFY_URL=https://ntfy.sh/chronolab-change-me-to-something-random
# NTFY_TOKEN=   # only for protected/self-hosted topics
